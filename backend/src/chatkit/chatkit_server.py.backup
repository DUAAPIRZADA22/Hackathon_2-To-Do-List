"""
ChatKit Store Implementation for Todo AI Chatbot

Implements Store interface from chatkit.store with proper method signatures.
This is an in-memory store that can be extended to use PostgreSQL.

Key Points from Skill:
- load_threads must include 'after' and 'order' parameters (Pitfall #3)
- load_thread should auto-create threads for ChatKit SDK compatibility (Pitfall #5)
- Must return Page objects with pagination info (Pitfall #8)
"""

import uuid
from collections import defaultdict
from typing import Any, AsyncIterator, Dict, List, Optional

from chatkit.store import Store, NotFoundError
from chatkit.types import (
    ThreadMetadata,
    ThreadItem,
    Attachment,
    Page,
)
from chatkit.types import (
    UserMessageItem,
    AssistantMessageItem,
    AssistantMessageContent,
)
from chatkit.server import ChatKitServer, StreamingResult
from chatkit.agents import simple_to_agent_input
import structlog

# Try backend.src imports first, fall back to src imports
try:
    from backend.src.agent.runner import AgentRunner
    from backend.src.db.session import async_session_maker
    from backend.src.db.models import Conversation, Message as MessageModel
    from sqlalchemy import select, asc
except ImportError:
    from src.agent.runner import AgentRunner
    from src.db.session import async_session_maker
    from src.db.models import Conversation, Message as MessageModel
    from sqlalchemy import select, asc


logger = structlog.get_logger()


# =====================================================
# Store Implementation
# =====================================================

class TodoChatKitStore(Store[Dict[str, Any]]):
    """
    Store implementation for Todo AI Chatbot.

    Wraps existing PostgreSQL database for ChatKit compatibility.
    Implements all required Store methods with proper signatures.
    """

    async def load_thread(
        self,
        thread_id: str,
        context: Dict[str, Any]
    ) -> ThreadMetadata:
        """
        Load thread metadata by ID.

        IMPORTANT: Auto-create thread if it doesn't exist (Pitfall #5)
        ChatKit SDK expects this behavior.
        """
        user_id = context.get("user_id")
        if not user_id:
            raise NotFoundError(f"user_id required in context")

        async with async_session_maker() as session:
            query = select(Conversation).where(
                Conversation.id == uuid.UUID(thread_id),
                Conversation.user_id == int(user_id)
            )
            result = await session.execute(query)
            conv = result.scalar_one_or_none()

            if conv:
                # Thread exists, return metadata
                from datetime import datetime
                return ThreadMetadata(
                    id=str(conv.id),
                    title=conv.title,
                    created_at=conv.created_at,
                    updated_at=conv.updated_at,
                    metadata={"user_id": user_id}
                )
            else:
                # Auto-create thread for ChatKit SDK compatibility (Pitfall #5)
                from datetime import datetime
                new_conv = Conversation(
                    user_id=int(user_id),
                    title="New Chat"
                )
                session.add(new_conv)
                await session.commit()
                await session.refresh(new_conv)

                new_thread = ThreadMetadata(
                    id=str(new_conv.id),
                    title="New Chat",
                    created_at=new_conv.created_at,
                    updated_at=new_conv.updated_at,
                    metadata={"user_id": user_id}
                )

                # Save to store
                await self.save_thread(new_thread, context)

                logger.info(f"Auto-created thread {thread_id} for user {user_id}")
                return new_thread

    async def save_thread(
        self,
        thread: ThreadMetadata,
        context: Dict[str, Any]
    ) -> None:
        """Save/update thread metadata."""
        user_id = context.get("user_id")
        if not user_id:
            return

        async with async_session_maker() as session:
            query = select(Conversation).where(
                Conversation.id == uuid.UUID(thread.id),
                Conversation.user_id == int(user_id)
            )
            result = await session.execute(query)
            conv = result.scalar_one_or_none()

            if conv:
                # Update existing
                conv.title = thread.title
                conv.updated_at = thread.updated_at if thread.updated_at else conv.created_at
            else:
                # Create new
                conv = Conversation(
                    id=uuid.UUID(thread.id),
                    user_id=int(user_id),
                    title=thread.title,
                    created_at=thread.created_at,
                    updated_at=thread.updated_at if thread.updated_at else thread.created_at
                )
                session.add(conv)

            await session.commit()

    async def load_threads(
        self,
        limit: int,
        after: Optional[str],
        order: str,
        context: Dict[str, Any]
    ) -> Page[ThreadMetadata]:
        """
        Load threads with pagination.

        IMPORTANT: Must include 'after' and 'order' parameters (Pitfall #3)
        Must return Page object (Pitfall #8)
        """
        user_id = context.get("user_id")
        if not user_id:
            return Page(data=[], has_more=False, after=None)

        async with async_session_maker() as session:
            query = select(Conversation).where(
                Conversation.user_id == int(user_id)
            )

            # Order by created_at
            if order == "desc":
                query = query.order_by(Conversation.created_at.desc())
            else:
                query = query.order_by(Conversation.created_at.asc())

            # Apply pagination (after cursor)
            if after:
                # For simplicity, we'll just use offset for now
                # In production, you'd want to decode the cursor
                try:
                    after_date = self._decode_cursor(after)
                    # This is simplified - proper cursor pagination would be more complex
                    pass
                except:
                    pass

            query = query.limit(limit + 1)  # Fetch one extra to check has_more
            result = await session.execute(query)
            convs = result.scalars().all()

            # Check if there are more results
            has_more = len(convs) > limit
            if has_more:
                convs = convs[:limit]
                next_after = self._encode_cursor(convs[-1].created_at)
            else:
                next_after = None

            # Convert to ThreadMetadata
            threads = [
                ThreadMetadata(
                    id=str(conv.id),
                    title=conv.title,
                    created_at=conv.created_at,
                    updated_at=conv.updated_at,
                    metadata={"user_id": user_id}
                )
                for conv in convs
            ]

            return Page(data=threads, has_more=has_more, after=next_after)

    async def load_thread_items(
        self,
        thread_id: str,
        after: Optional[str],
        limit: int,
        order: str,
        context: Dict[str, Any]
    ) -> Page[ThreadItem]:
        """Load thread items with pagination."""
        async with async_session_maker() as session:
            query = select(MessageModel).where(
                MessageModel.conversation_id == uuid.UUID(thread_id)
            )

            # Order by created_at
            if order == "desc":
                query = query.order_by(MessageModel.created_at.desc())
            else:
                query = query.order_by(MessageModel.created_at.asc())

            # Apply pagination
            if after:
                # Simplified - skip items with created_at <= after's timestamp
                # In production, decode cursor properly
                try:
                    after_timestamp = self._decode_cursor(after)
                    query = query.where(MessageModel.created_at > after_timestamp)
                except:
                    pass

            query = query.limit(limit + 1)  # Fetch extra for has_more check
            result = await session.execute(query)
            messages = result.scalars().all()

            has_more = len(messages) > limit
            if has_more:
                messages = messages[:limit]
                next_after = self._encode_cursor(messages[-1].created_at)
            else:
                next_after = None

            # Convert to ThreadItem
            items = []
            for msg in messages:
                if msg.role == "user":
                    from chatkit.types import UserMessageContent
                    items.append(ThreadItem(
                        id=str(msg.id) if msg.id else self._generate_id(),
                        thread_id=thread_id,
                        created_at=msg.created_at,
                        content=[UserMessageContent(text=msg.content or "")],
                        role="user"
                    ))
                elif msg.role == "assistant":
                    items.append(ThreadItem(
                        id=str(msg.id) if msg.id else self._generate_id(),
                        thread_id=thread_id,
                        created_at=msg.created_at,
                        content=[AssistantMessageContent(text=msg.content or "")],
                        role="assistant"
                    ))

            return Page(data=items, has_more=has_more, after=next_after)

    async def add_thread_item(
        self,
        thread_id: str,
        item: ThreadItem,
        context: Dict[str, Any]
    ) -> None:
        """Add a new item to thread."""
        async with async_session_maker() as session:
            # Determine role from content
            role = "user" if item.role == "user" else "assistant"

            # Extract text content
            text = ""
            if item.content:
                for content_part in item.content:
                    if hasattr(content_part, 'text'):
                        text = content_part.text
                        break

            message = MessageModel(
                conversation_id=uuid.UUID(thread_id),
                role=role,
                content=text,
            )
            session.add(message)
            await session.commit()

    async def save_item(
        self,
        thread_id: str,
        item: ThreadItem,
        context: Dict[str, Any]
    ) -> None:
        """Upsert thread item by ID."""
        # For simplicity, we'll just add (implement upsert if needed)
        await self.add_thread_item(thread_id, item, context)

    async def load_item(
        self,
        thread_id: str,
        item_id: str,
        context: Dict[str, Any]
    ) -> ThreadItem:
        """Load specific thread item."""
        async with async_session_maker() as session:
            query = select(MessageModel).where(
                MessageModel.conversation_id == uuid.UUID(thread_id),
                MessageModel.id == uuid.UUID(item_id)
            )
            result = await session.execute(query)
            msg = result.scalar_one_or_none()

            if not msg:
                raise NotFoundError(f"Item {item_id} not found")

            if msg.role == "user":
                from chatkit.types import UserMessageContent
                return ThreadItem(
                    id=str(msg.id),
                    thread_id=thread_id,
                    created_at=msg.created_at,
                    content=[UserMessageContent(text=msg.content or "")],
                    role="user"
                )
            else:
                return ThreadItem(
                    id=str(msg.id),
                    thread_id=thread_id,
                    created_at=msg.created_at,
                    content=[AssistantMessageContent(text=msg.content or "")],
                    role="assistant"
                )

    async def delete_thread(
        self,
        thread_id: str,
        context: Dict[str, Any]
    ) -> None:
        """Delete thread and all items."""
        async with async_session_maker() as session:
            # Delete messages first (foreign key constraint)
            await session.execute(
                select(MessageModel).where(
                    MessageModel.conversation_id == uuid.UUID(thread_id)
                )
            )
            # Delete conversation
            conv = await session.get(Conversation, uuid.UUID(thread_id))
            if conv:
                await session.delete(conv)
                await session.commit()

    async def delete_thread_item(
        self,
        thread_id: str,
        item_id: str,
        context: Dict[str, Any]
    ) -> None:
        """Delete specific thread item."""
        async with async_session_maker() as session:
            msg = await session.get(MessageModel, uuid.UUID(item_id))
            if msg and str(msg.conversation_id) == thread_id:
                await session.delete(msg)
                await session.commit()

    # Attachments - not implemented for this use case
    async def save_attachment(
        self,
        attachment: Attachment,
        context: Dict[str, Any]
    ) -> None:
        """Not implemented - no file attachments needed."""
        pass

    async def load_attachment(
        self,
        attachment_id: str,
        context: Dict[str, Any]
    ) -> Attachment:
        """Not implemented - no file attachments needed."""
        raise NotFoundError(f"Attachment {attachment_id} not found")

    async def delete_attachment(
        self,
        attachment_id: str,
        context: Dict[str, Any]
    ) -> None:
        """Not implemented - no file attachments needed."""
        pass

    def _generate_id(self) -> str:
        """Generate unique ID."""
        return str(uuid.uuid4())

    def _encode_cursor(self, timestamp) -> str:
        """Encode timestamp to cursor."""
        return timestamp.isoformat() if hasattr(timestamp, 'isoformat') else str(timestamp)

    def _decode_cursor(self, cursor: str):
        """Decode cursor to timestamp."""
        from datetime import datetime
        try:
            return datetime.fromisoformat(cursor)
        except:
            return cursor


# =====================================================
# ChatKit Server Implementation
# =====================================================

class TodoChatKitServer(ChatKitServer[Dict[str, Any]]):
    """
    Todo AI ChatKit Server.

    Implements the respond() method with streaming support.
    Uses existing AgentRunner and MCP tools infrastructure.

    Key Points from Skill:
    - Use server.process() not custom endpoint logic (Pitfall #7)
    - Replace __fake_id__ with unique IDs (Pitfall #9)
    - Pass conversation history not just user_message (Pitfall #4)
    """

    def __init__(self, store: TodoChatKitStore):
        super().__init__(store, attachment_store=None)
        logger.info("TodoChatKitServer initialized")

    async def respond(
        self,
        thread: ThreadMetadata,
        input: UserMessageItem | None,
        context: Dict[str, Any],
    ) -> AsyncIterator:
        """Respond to user message by processing with AgentRunner and yielding ChatKit events."""
        user_id = context.get("user_id")
        thread_id = thread.id

        print(f"[ChatKit] respond: user_id={user_id}, thread_id={thread_id}")

        if not user_id:
            print(f"[ChatKit] ERROR: No user_id in context")
            yield self._error_event("user_id not found in context")
            return

        # Extract user message
        user_content = ""
        if input and input.content:
            for content_part in input.content:
                if hasattr(content_part, 'text'):
                    user_content = content_part.text
                    break

        print(f"[ChatKit] user_content: '{user_content}'")

        if not user_content:
            print(f"[ChatKit] WARNING: No user content, skipping")
            # This is okay - might be just a thread load
            return

        try:
            # Use existing AgentRunner
            agent = AgentRunner(user_id=user_id)
            print(f"[ChatKit] Calling AgentRunner.chat...")

            result = await agent.chat(
                message=user_content,
                conversation_history=[],  # Start fresh for simplicity
                stream=False
            )

            response_text = result.get("response", "")
            print(f"[ChatKit] AgentRunner response: {response_text[:100]}...")

            # Generate unique message ID
            import uuid
            unique_message_id = f"msg_{uuid.uuid4().hex[:16]}"

            # Import required types
            from chatkit.types import AssistantMessageItem, AssistantMessageContent
            from chatkit.events import (
                ThreadMessageItemCreatedEvent,
                ThreadItemDoneEvent,
                ThreadItemRunningEvent
            )
            from datetime import datetime

            now = datetime.utcnow()

            # Yield running event
            print(f"[ChatKit] Yielding ThreadItemRunningEvent")
            yield ThreadItemRunningEvent(
                item=AssistantMessageItem(
                    id=unique_message_id,
                    thread_id=thread_id,
                    created_at=now,
                    content=[AssistantMessageContent(text="")]
                )
            )

            # Yield message created event
            print(f"[ChatKit] Yielding ThreadMessageItemCreatedEvent")
            yield ThreadMessageItemCreatedEvent(
                item=AssistantMessageItem(
                    id=unique_message_id,
                    thread_id=thread_id,
                    created_at=now,
                    content=[AssistantMessageContent(text=response_text)]
                )
            )

            # Yield done event
            print(f"[ChatKit] Yielding ThreadItemDoneEvent")
            yield ThreadItemDoneEvent(
                item=AssistantMessageItem(
                    id=unique_message_id,
                    thread_id=thread_id,
                    created_at=now,
                    content=[AssistantMessageContent(text=response_text)]
                )
            )

            print(f"[ChatKit] respond completed successfully")

        except Exception as e:
            print(f"[ChatKit] ERROR in respond: {e}")
            import traceback
            traceback.print_exc()
            yield self._error_event(str(e))

    def _error_event(self, message: str):
        """Create an error event."""
        from chatkit.types import ErrorEvent
        return ErrorEvent(
            error_code="ServerError",
            message=message
        )

    def _extract_text(self, item: ThreadItem) -> str:
        """Extract text content from ThreadItem."""
        if not item.content:
            return ""
        for content_part in item.content:
            if hasattr(content_part, 'text'):
                return content_part.text
        return ""


__all__ = ["TodoChatKitStore", "TodoChatKitServer"]
