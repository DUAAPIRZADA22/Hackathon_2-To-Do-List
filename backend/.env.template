# Database Configuration
# PostgreSQL connection string for Neon Serverless or local PostgreSQL
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/todo_db?sslmode=require

# LLM Provider Configuration (Primary)
# Get your API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI Configuration (Required for ChatKit)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Optional: OpenRouter Fallback
# Get your API key from: https://openrouter.ai
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# Better Auth Configuration
# Generate a random secret with: python -c "import secrets; print(secrets.token_urlsafe(32))"
BETTER_AUTH_SECRET=your-random-secret-at-least-32-chars-long-change-this
BETTER_AUTH_URL=http://localhost:3000

# CORS Configuration
# Frontend URL for CORS headers (development)
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ChatKit Configuration
CHATKIT_ENABLED=true
# Get your workflow ID from: https://platform.openai.com/agent-builder
CHATKIT_WORKFLOW_ID=wf_your_workflow_id_here

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Application Settings
APP_ENV=development
LOG_LEVEL=info

# Optional: Feature Flags
ENABLE_VOICE_INPUT=true
ENABLE_RATE_LIMITING=true
