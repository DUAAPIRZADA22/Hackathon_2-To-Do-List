# ActionMindAI Production Environment Configuration
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# ============================================
# CRITICAL SECRETS - MUST BE CONFIGURED
# ============================================

# Database - Neon PostgreSQL (Recommended)
# Get free database at: https://neon.tech
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# OpenAI API Key (Required for ChatKit)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Better Auth Secret (Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
BETTER_AUTH_SECRET=CHANGE_THIS_TO_A_RANDOM_32_CHAR_SECRET

# ============================================
# OPTIONAL CONFIGURATION
# ============================================

# Gemini API (Alternative LLM provider)
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ChatKit Configuration
CHATKIT_ENABLED=true
CHATKIT_WORKFLOW_ID=wf_your_workflow_id_here
NEXT_PUBLIC_CHATKIT_DOMAIN_KEY=domain_pk_your_domain_key_here

# CORS Configuration (Space-separated list of allowed origins)
CORS_ORIGINS=http://localhost:3000 http://localhost:8000

# Application URLs
FRONTEND_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# Logging
LOG_LEVEL=info

# Feature Flags
ENABLE_VOICE_INPUT=true
ENABLE_RATE_LIMITING=true

# ============================================
# DEVELOPMENT ONLY (Not used in Docker Compose)
# ============================================
# API_HOST=0.0.0.0
# API_PORT=8000
# API_RELOAD=true
# APP_ENV=development
