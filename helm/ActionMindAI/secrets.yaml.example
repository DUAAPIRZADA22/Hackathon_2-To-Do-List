# ActionMindAI Kubernetes Secrets
# Copy this file to secrets.yaml and fill in the actual values
# DO NOT commit secrets.yaml to version control

# PostgreSQL Database Connection String
# Format: postgresql://user:password@host:port/database
# For local development with Minikube, you may use an external database
# Example: postgresql://postgres:password@localhost:5432/actionmindai
databaseUrl: "postgresql://user:password@host:5432/actionmindai"

# OpenAI API Key
# Get your API key from: https://platform.openai.com/api-keys
# Required for LLM functionality in the chatbot
openaiApiKey: "sk-your-openai-api-key-here"

# Better Auth Secret
# Generate a secure random string for session encryption
# Run: openssl rand -base64 32
# Used for authentication session management
betterAuthSecret: "generate-with-openssl-rand-base64-32"
